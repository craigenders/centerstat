# Model 3: Sensitivity analysis with a Yeo-Johnson normalized outcome

DATA: inflammation.dat;                           # text data file
VARIABLES: id female elstress age
  inflam1:inflam4 inflam dpdd hdd;                # variable list
ORDINAL: female;                                  # binary/ordinal variables
NOMINAL: elstress;                                # automatic dummy coding
MISSING: NA;                                      # missing value code
CENTER: inflam age;                               # grand mean centering
MODEL: yjt(dpdd - 6) ~ inflam elstress female age;   # normalized outcome
SEED: 90291;                                      # random number seed
BURN: 10000;                                      # warm-up iterations
ITER: 10000;                                      # analysis iterations